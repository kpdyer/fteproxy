{
  "imap-request": {
    "regex": "^a[0-9]+ (LOGIN [a-z][a-z0-9._-]* [A-Za-z0-9!#$%&*+._-]+|SELECT [A-Za-z][A-Za-z0-9/._-]*|FETCH [0-9]+:[0-9]+ \\(FLAGS BODY\\[[A-Z.]*\\]\\)|STORE [0-9]+ [+-]FLAGS \\(\\\\[A-Za-z]+\\)|SEARCH (FROM|TO|SUBJECT|BODY) [A-Za-z0-9 ._@-]+)\\r\\n$",
    "length": 256,
    "port": [
      143
    ],
    "role": "request",
    "mode_hint": "format",
    "default": false,
    "description": "IMAP4rev1 tagged client command (LOGIN, SELECT, FETCH, STORE, SEARCH)"
  },
  "imap-response": {
    "regex": "^(\\* (OK|NO|BAD) [A-Za-z0-9 .,;:()_@/-]+|\\* [0-9]+ (EXISTS|RECENT)|a[0-9]+ (OK|NO|BAD) [A-Za-z0-9 .,;:()_@/-]+)\\r\\n$",
    "length": 256,
    "port": [
      143
    ],
    "role": "response",
    "mode_hint": "format",
    "default": false,
    "description": "IMAP4rev1 untagged status/EXISTS/RECENT line or tagged completion"
  }
}
