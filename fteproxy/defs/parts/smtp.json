{
  "smtp-request": {
    "regex": "^(EHLO [a-z0-9.-]+|HELO [a-z0-9.-]+|MAIL FROM:<[a-z0-9._%+-]+@[a-z0-9.-]+>|RCPT TO:<[a-z0-9._%+-]+@[a-z0-9.-]+>|VRFY [a-z0-9._%+-]+|DATA|RSET|NOOP|QUIT)\r\n$",
    "min_length": 80,
    "max_length": 320,
    "terminator": "\r\n",
    "port": [
      25,
      587
    ],
    "role": "request",
    "mode_hint": "format",
    "default": false,
    "description": "SMTP command shape with a CRLF terminator; 80-320 bytes per format-mode record."
  },
  "smtp-response": {
    "regex": "^((220|250|354|421|550) |250-)[a-zA-Z0-9 .,;:()<>@_-]+\r\n$",
    "min_length": 80,
    "max_length": 320,
    "terminator": "\r\n",
    "port": [
      25,
      587
    ],
    "role": "response",
    "mode_hint": "format",
    "default": false,
    "description": "SMTP status/text shape, including 250- continuation lines; 80-320 bytes per format-mode record."
  }
}
